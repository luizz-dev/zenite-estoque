# Configuração de NFe - PRODUÇÃO (Real)

#  MUITA ATENÇÃO 
# Este arquivo é para PRODUÇÃO.
# TUDO AQUI É REAL:
# - Notas têm valor fiscal
# - Qualquer erro pode resultar em problemas legais
# - Deve ser revisado e validado antes de usar
# - Exige certificado A1 com dados reais e válidos

# CHECKLIST ANTES DE USAR EM PRODUÇÃO:
# [ ] Certificado digital A1 válido instalado
# [ ] CNPJ verificado e correto
# [ ] Email de notificação funciona
# [ ] Backup do certificado realizado
# [ ] Testes em homologação completados com sucesso
# [ ] Documentação de versão de NFe validada
# [ ] Suporte técnico/contador informado

# Qual ambiente usar
NFE_ENVIRONMENT=producao

# CERTIFICADO DIGITAL REAL (A1)
# CRÍTICO: Deve ser certificado A1 válido com dados da empresa

# Caminho absoluto do arquivo .pfx
# Windows: C:\Program Files\Certificados\certificado-empresa.pfx
# Linux:   /etc/ssl/nfe/certificado-empresa.pfx

# SEGURANÇA:
# - Restricionalize acesso ao arquivo (chmod 600 em Linux)
# - Faça backup em local seguro
# - Nunca commite em repositório
NFE_CERTIFICATE_PATH=/etc/ssl/nfe/certificado-empresa.pfx

# Senha do certificado digital
# SEGURANÇA CRÍTICA:
# - NUNCA coloque junto com código
# - Use um gerenciador de secrets:
#   * AWS Secrets Manager
#   * Hashicorp Vault
#   * Azure Key Vault
#   * Docker Secrets
#   * Variável de ambiente do sistema
NFE_CERTIFICATE_PASSWORD=${CERTIFICATE_PASSWORD}

# CNPJ DA EMPRESA
# Deve ser o CNPJ real e válido da sua empresa
# Formato: XX.XXX.XXX/0001-XX
NFE_CNPJ=00.000.000/0001-00

# Configurações de Produção
# Banco de dados de produção
# DATABASE_URL=postgresql://user:password@prod-db.example.com:5432/nfe_producao

# Logging - mais detalhado em produção
# LOG_LEVEL=info
# LOG_FILE=/var/log/nfe/nfe-producao.log

# Email para notificações críticas
# ADMIN_EMAIL=nfi-admin@seudominio.com
# SUPPORT_EMAIL=suporte@seudominio.com

# Monitoramento
# SENTRY_DSN=https://key@sentry.io/12345
# DATADOG_API_KEY=sua_api_key

# Informações bancárias para reembolsos de testes
# BANK_ACCOUNT=00000-0
# BANK_ROUTING=00000000