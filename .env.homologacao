# Configuração de NFe - HOMOLOGAÇÃO (Testes)
#
# ESTE ARQUIVO: Ambiente de testes para validar a integração com NFe
# 
# Conecta aos servidores de TESTE da Receita Federal
# Notas aqui NÃO têm valor fiscal
# Perfeito para desenvolvimento e testes
# Aceita certificado de teste
#
# CUIDADO:
# - Notas em série 900-999 são reconhecidas como teste
# - Não emita em série real durante testes
# - Sempre valide e teste aqui ANTES de ir para produção

# Qual ambiente usar
NFE_ENVIRONMENT=homologacao

# CERTIFICADO DIGITAL DE TESTE
# Podemos:
# 1. Usar um certificado de teste (fornecido pela Receita Federal)
# 2. Usar seu certificado real (mesmo em homologação)

# Caminho absoluto do arquivo .pfx

# Windows: C:\Users\Usuario\Certificados\certificado-teste.pfx
# Linux:   /home/usuario/certificados/certificado-teste.pfx

NFE_CERTIFICATE_PATH=/path/to/your/test-certificate.pfx

# Senha do certificado de teste
# Pode ser obtida com quem gerou o certificado
NFE_CERTIFICATE_PASSWORD=senha_do_certificado

# CNPJ PARA HOMOLOGAÇÃO
# Use o CNPJ de teste da Receita Federal: 34.028.316/0001-02
# Isto garante que a Receita reconheçaa como teste
NFE_CNPJ=34.028.316/0001-02

# Configurações adicionais (se necessário)
# Banco de dados
# DATABASE_URL=postgresql://user:password@localhost:5432/nfe_homolog

# Logging
# LOG_LEVEL=debug
# LOG_FILE=/var/log/nfe/nfe-homolog.log

# Timeouts
# NFE_TIMEOUT=30

# Email para notificações
# ADMIN_EMAIL=admin@seudominio.com
