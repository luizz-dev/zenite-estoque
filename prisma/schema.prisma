// ============================================================================
// PRISMA SCHEMA — Zênite (multi-tenant)
// ============================================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             String   @id @default(cuid())
  nome           String
  email          String   @unique
  senhaHash      String
  celular        String
  cpfCnpj        String?
  cep            String?
  endereco       String?
  formaPagamento String?
  criadoEm       DateTime @default(now())

  empresa       Empresa?
  assinatura    Assinatura?
  produtos      Produto[]
  notasFiscais  NotaFiscal[]
  contasFixas   ContaFixa[]
  movimentacoes Movimentacao[]
  notificacoes  Notificacao[]

  @@map("usuarios")
}

model Empresa {
  id              String   @id @default(cuid())
  configurada     Boolean  @default(false)
  razaoSocial     String   @default("")
  cnpj            String   @default("")
  ie              String   @default("")
  uf              String   @default("SP")
  regime          String   @default("MEI — Simples Nacional")
  cep             String   @default("")
  rua             String   @default("")
  numero          String   @default("")
  bairro          String   @default("")
  cidade          String   @default("")
  certificadoNome String   @default("")
  atualizadoEm    DateTime @updatedAt

  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("empresa")
}

model Produto {
  id               String   @id @default(cuid())
  nome             String
  sku              String
  categoria        String
  unidade          String   @default("UN")
  quantidade       Int      @default(0)
  quantidadeMinima Int      @default(8)
  precoCusto       Float
  precoVenda       Float
  fornecedor       String?
  ncm              String
  descricao        String?
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  itensNota ItemNotaFiscal[]

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // SKU deixou de ser único globalmente e passou a ser único POR USUÁRIO
  // (dois usuários diferentes podem ter um produto "SKU-001" cada um).
  @@unique([usuarioId, sku])
  @@index([usuarioId])
  @@map("produtos")
}

model NotaFiscal {
  id               String   @id @default(cuid())
  numero           Int
  destinatarioTipo String
  destinatarioDoc  String
  destinatarioNome String
  destinatarioIe   String?
  destinatarioUf   String
  enderecoEntrega  Json?
  csosn            String
  formaPagamento   String
  valorTotal       Float
  statusFiscal     String   @default("autorizada")
  motivoRejeicao   String?
  emitidaEm        DateTime @default(now())

  itens ItemNotaFiscal[]

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Número da nota deixou de ser único globalmente e passou a ser único
  // POR USUÁRIO (a numeração de NF-e é por emissor, não compartilhada).
  @@unique([usuarioId, numero])
  @@index([usuarioId])
  @@map("notas_fiscais")
}

model ContaFixa {
  id                    String   @id @default(cuid())
  nome                  String
  valor                 Float
  categoria             String   @default("Outros")
  diaVencimento         Int      @default(10)
  tipo                  String   @default("fixa")
  avisoAntecedenciaDias Int      @default(7)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("contas_fixas")
}

model Assinatura {
  id              String    @id @default(cuid())
  plano           String    @default("mensal")
  status          String    @default("ativa")
  valor           Float     @default(49.9)
  formaPagamento  String    @default("Cartão de Crédito")
  proximaCobranca DateTime?
  atualizadoEm    DateTime  @updatedAt

  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("assinatura")
}

model ItemNotaFiscal {
  id            String     @id @default(cuid())
  notaId        String
  nota          NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto    @relation(fields: [produtoId], references: [id])
  nome          String
  sku           String
  ncm           String
  cfop          String
  quantidade    Int
  valorUnitario Float

  @@map("itens_nota_fiscal")
}

model Movimentacao {
  id         String   @id @default(cuid())
  tipo       String
  item       String
  quantidade Int
  motivo     String?
  observacao String?
  data       DateTime @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("movimentacoes")
}

model Notificacao {
  id         String   @id @default(cuid())
  tipo       String
  titulo     String
  descricao  String
  prioridade String
  lida       Boolean  @default(false)
  criadoEm   DateTime @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("notificacoes")
}
